# D-Tools Cloud API (used by .claude/skills/d-tools-skill)
# In Claude Code cloud sessions, set BOTH variables in the environment settings
# instead of using a .env file. Never commit real values.
DTOOLS_BASE_URL=https://dtcloudapi.d-tools.cloud/api/v1

# Tenant secret — from D-Tools Cloud UI: Settings > Integration > Developer > API Keys.
DTOOLS_API_KEY=your-tenant-api-key-here

# D-Tools' FIXED Authorization value, published in their Cloud API Authentication
# article (docs.d-tools.cloud). Required alongside X-API-Key. We keep the literal
# value out of the repo so secret scanners stay clean — copy it from the docs.
DTOOLS_BASIC_AUTH="Basic <fixed value from D-Tools authentication docs>"

# ---- System Designer services (gateway + worker). Production values live in Secret Manager. ----
RELEASE_ID=dev-local
DATABASE_URL=postgres://localhost:5432/system_designer
EVIDENCE_BUCKET=livewire-system-designer-evidence
TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_API_KEY=
# Approved model is a production decision for Henry (PRD §23); set it explicitly.
LLM_MODEL=
ANTHROPIC_API_KEY=
# The HTTPS URL configured as the Google Chat app's endpoint (token audience).
GOOGLE_CHAT_ENDPOINT_URL=https://<gateway-host>/chat/google

# How the held PDF is uploaded into Google Chat (no extra Workspace seat either way):
#   app       = as the Chat app itself, if Google allows attachment upload for the app
#   delegated = as an existing Workspace user via domain-wide delegation (Chat create scope only)
GOOGLE_CHAT_UPLOAD_MODE=app
GOOGLE_CHAT_DELEGATED_USER=
# Read-only D-Tools access for the worker (same values as DTOOLS_API_KEY / DTOOLS_BASIC_AUTH above).
# Optional override for the Chromium binary used to render PDFs.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
